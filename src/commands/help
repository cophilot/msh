#!/bin/bash

###START###

# Get help for myshell
function help_command {

	com=${VALUES[0]}

	if [ ! -z "$com" ]; then
		com_fn="${com}_help"
		com_fn=$(echo $com_fn | sed 's/-/_/g')
		if ! declare -f $com_fn >/dev/null; then
			log_e "Command not found: $com"
			myexit 1
		fi

		print_help_header
		$com_fn
		print_help_footer $com
		myexit 0
	fi

	print_help_header
	log "Commands:"
	for cmd in "${ALL_MSH_COMMANDS[@]}"; do
		cmd_fn="${cmd}_help"
		cmd_fn=$(echo $cmd_fn | sed 's/-/_/g')
		if declare -f $cmd_fn >/dev/null; then
			$cmd_fn
		fi
	done
	print_help_footer
}

# Print the help header
function print_help_header {
	log "                          __         ____"
	log "    ____ ___  __  _______/ /_  ___  / / /"
	log "   / __  __ \/ / / / ___/ __ \/ _ \/ / / "
	log "  / / / / / / /_/ (__  ) / / /  __/ / /  "
	log " /_/ /_/ /_/\__, /____/_/ /_/\___/_/_/   "
	log "           /____/ Help center"
	log ""
	log "Usage: msh <command>"
	log ""
	log "<...> = required"
	log "[...] = optional"
	log ""
}

# Print the help footer
# $1 - The command to get help for
function print_help_footer() {
	com=$1
	log " Global flags (apply to all commands):"
	log "  --quiet|--q - Do not print any output"
	log ""
	if [ -n "$com" ]; then
		com="command/$com"
	fi
	log "To get more information please visit: https://myshell.philipp-bonin.com/$com"
}

# Print help for the help command
function help_help {
	log "  help|h [command] - Get help for myshell"
	log "      command - The command to get help for"
	log ""
}

# Autocomplete helper for the help command. This gets called by the autocomplete function in src/commands/autocomplete.sh
function help_autocomplete_helper {
	all_commands=$(echo "${ALL_MSH_COMMANDS[@]}" | tr ' ' '\n')
	echo "$all_commands"
}

# Short form of the help command
function h_command {
	help_command $*
}

# Covering dashes in the command name
function _help_command {
	help_command $*
}

# Covering dashes in the command short form
function _h_command {
	help_command $*
}

###END###
