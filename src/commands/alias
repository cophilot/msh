#!/bin/bash

###START###

# Enables generating alias easily.
function alias_command {
	require_msh_home_dir
	script_name=${VALUES[0]}
	rest_arguments=${VALUES[@]:1}

	if [ -z "$script_name" ]; then
		log "Please provide the name for the new-script"
		myexit 1
	fi
	if [ -z "$rest_arguments" ]; then
		log "Please provide the command to create an alias for"
		myexit 1
	fi

	collection_name=$(get_default_collection)

	check_if_command_exists $script_name

	sc_dir="$HOME_DIR/$collection_name"

	description="Alias for '$rest_arguments'"
	cmd2="$rest_arguments \$*"
	cmd1="echo \"$cmd2\""

	create_new_script $sc_dir $script_name "$description" "$cmd1" "$cmd2"

	log "Alias script '$script_name' created ($sc_dir/$script_name)"
}

# Print help for the alias command
function alias_help {
	log "  alias|a <script-name> <content> - Create a new alias for a command"
	log "      script-name - The name of the new script to create"
	log "      content - The content of the new script to create"
	log ""
}

# Short form of the alias help command
function a_help {
	alias_help $*
}

# Short form of the alias command
function a_command {
	alias_command $*
}

###END###
